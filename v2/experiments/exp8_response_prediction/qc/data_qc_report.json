  "follow_up_investigations": {
    "gse32062_platform_resolution": {
      "finding": "The 10 GPL570 (Affymetrix) samples are NOT in the pooled matrix. They were filtered during gene intersection (Agilent and Affymetrix have different probe sets). All 260 pooled samples are GPL6480 (Agilent).",
      "flagged_outliers_overlap": "The 24 flagged outlier samples are ALL GPL6480 (Agilent), not Affymetrix. They are likely low-quality Agilent samples.",
      "action_needed": "No platform mixing issue. The 24 outlier Agilent samples should be investigated but are not a platform artifact."
    },
    "gse28739_two_channel_issue": {
      "finding": "GSE28739 is a two-channel dye-swap microarray (25 patients x 2 dye-swap replicates = 50 arrays). Values are log-ratios relative to a common reference pool, NOT absolute expression. Rank-transforming log-ratios produces fundamentally different results than rank-transforming absolute expression values.",
      "within_dataset_correlation": 0.211,
      "comparison_other_datasets": "0.7-0.9 for all other datasets",
      "sample_count": 25,
      "all_samples_flagged": true,
      "recommendation": "EXCLUDE GSE28739 from pooled analysis. Two-channel log-ratio data is incompatible with single-channel expression data even after rank transform. The dataset has only 25 samples and all are flagged as outliers.",
      "label_source": "chemoresistant (R, n=15) vs chemosensitive (S, n=10) from sample annotations"
    },
    "tcga_ov_label_verification": {
      "finding": "TCGA-OV response_binary labels perfectly match TCGA PLATINUM_STATUS annotation (0 mismatches in 235 samples). Labels are NOT based on PFI > 6m threshold.",
      "sensitive_dfs_median_months": 20.2,
      "resistant_dfs_median_months": 9.1,
      "sensitive_with_dfs_le_6m": "1/165 (0.6%)",
      "resistant_with_dfs_gt_6m": "56/70 (80%)",
      "explanation": "PLATINUM_STATUS in TCGA incorporates clinical assessment beyond just PFI (best response, drug tolerance, clinician judgment). 80% of Resistant patients have DFS > 6m because platinum-resistance classification is more nuanced than a simple time threshold.",
      "verdict": "Labels are valid. Using TCGA PLATINUM_STATUS is standard practice."
    }
  },
  "qc_summary": {
    "critical_findings": [
      {
        "issue": "Strong batch effect persists after rank transform",
        "evidence": "PCA silhouette score = 0.749 (>>0.3 threshold). First 3 PCs explain 51% of variance and are dominated by dataset identity.",
        "impact": "Models may learn dataset identity rather than biology. LODO-CV results may be pessimistic if batch effect is confounded with response.",
        "recommendation": "Include dataset covariate in all models. Consider Combat or other batch correction. Report per-dataset AUC with confidence intervals."
      },
      {
        "issue": "GSE28739: Two-channel data incompatible with single-channel datasets",
        "evidence": "All 25 samples flagged as outliers (mean corr=0.21). Two-channel dye-swap log-ratio design fundamentally different from single-channel expression.",
        "impact": "Including GSE28739 adds noise and confounds batch effect analysis.",
        "recommendation": "EXCLUDE from pooled analysis. Only 25 samples, minimal contribution."
      },
      {
        "issue": "GSE32062: Severe class imbalance (87% sensitive)",
        "evidence": "225 sensitive vs 35 resistant. AUC 95% CI under null is [0.40, 0.60].",
        "impact": "LODO-CV AUC on GSE32062 will have wide CI. Cannot distinguish signal from noise for AUC < 0.60.",
        "recommendation": "Report with CI. Consider down-weighting in training. The 24 outlier samples should be examined."
      }
    ],
    "moderate_findings": [
      {
        "issue": "GSE32062 has 24 outlier samples (mean corr < 0.5)",
        "evidence": "Some samples have correlation as low as -0.55 with dataset peers.",
        "recommendation": "Consider excluding these 24 samples. They may be mislabeled or corrupted."
      },
      {
        "issue": "GSE30161 has 1 outlier sample (GSM746905)",
        "evidence": "Mean corr = 0.45 vs dataset mean of 0.78.",
        "recommendation": "Flag but no immediate action needed (single sample)."
      },
      {
        "issue": "TCGA-OV labels based on clinical annotation, not PFI threshold",
        "evidence": "80% of Resistant patients have DFS > 6m.",
        "recommendation": "Document this. Standard practice but worth noting for interpretation."
      }
    ],
    "positive_findings": [
